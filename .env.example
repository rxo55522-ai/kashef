# كلمة دخول الأداة (للمدير ورئيس القسم فقط) - غيّرها قبل التشغيل
APP_PASSWORD=

# مفتاح Gemini المجاني من Google AI Studio: للكشف وإعادة الصياغة
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
# عدد مرات تقييم كل فقرة جديدة: 3 أكثر ثباتًا، و1 يوفر من الحد المجاني
GEMINI_SCAN_RUNS=3

# اختياري ومدفوع: إذا ملأت الحقلين يصبح الكشف عبر Copyleaks بدل Gemini
COPYLEAKS_EMAIL=
COPYLEAKS_API_KEY=
COPYLEAKS_SENSITIVITY=2
COPYLEAKS_SANDBOX=false

# اتركها 127.0.0.1 ليعمل على هذا الجهاز فقط
HOST=127.0.0.1
PORT=8765
